#!/bin/sh
# Sourced by bin/<%= @release.name %> before it reads RELEASE_COOKIE,
# RELEASE_NODE and RELEASE_DISTRIBUTION, under `set -e`: nothing here may fail.
#
# bd-51m9ba: Erlang distribution stays on so the operator's
# `bin/<%= @release.name %> rpc` / `remote` keep working, but anyone holding the
# cookie who reaches epmd and the node's port runs arbitrary code in the
# server. So:
#
#   * epmd binds 127.0.0.1 only. ERL_EPMD_ADDRESS is read by whichever node
#     starts epmd; an epmd that is already running keeps its old binding
#     (`arb doctor` reports it).
#   * the node is a long name on 127.0.0.1. Its listener is pinned to
#     loopback by vm.args (inet_dist_use_interface), and every rpc lookup goes
#     to epmd on 127.0.0.1. An sname would resolve the host name, often to a
#     LAN address where a loopback-only epmd does not answer.
#   * the cookie is a random per-install secret in <data-home>/release.cookie
#     (0600), never releases/COOKIE: that file ships inside the published
#     tarball, the same bytes for every install. The data home is the deploy's
#     (ARB_DATA_HOME, default ~/.arbiter), so the server and the operator's
#     rpc read the same file.

export ERL_EPMD_ADDRESS=127.0.0.1

RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
export RELEASE_DISTRIBUTION
RELEASE_NODE="${RELEASE_NODE:-<%= @release.name %>@127.0.0.1}"
export RELEASE_NODE

chmod 600 "$RELEASE_ROOT/releases/COOKIE" 2>/dev/null || :

arbiter_random_cookie () {
  od -An -N32 -tx1 /dev/urandom | tr -d ' \n'
}

# Print the cookie stored in $1, tightening the file to 0600 first.
arbiter_read_cookie () {
  [ -f "$1" ] || return 1
  chmod 600 "$1" 2>/dev/null || :
  arbiter_cookie_value=$(cat "$1" 2>/dev/null) || return 1
  [ -n "$arbiter_cookie_value" ] || return 1
  printf '%s' "$arbiter_cookie_value"
}

# Create $1 with a fresh random cookie unless it already exists. Written
# under umask 077 and published with `ln`, which is atomic and refuses to
# replace a cookie a concurrent invocation created first.
arbiter_create_cookie () {
  (
    umask 077
    mkdir -p "$(dirname "$1")" &&
      arbiter_random_cookie > "$1.$$.tmp" &&
      { ln "$1.$$.tmp" "$1" 2>/dev/null; rm -f "$1.$$.tmp"; }
  ) 2>/dev/null || :
}

if [ -z "${RELEASE_COOKIE:-}" ]; then
  arbiter_data_home="${ARB_DATA_HOME:-${HOME:-}/.arbiter}"
  arbiter_cookie_file="$arbiter_data_home/release.cookie"

  if ! RELEASE_COOKIE=$(arbiter_read_cookie "$arbiter_cookie_file"); then
    arbiter_create_cookie "$arbiter_cookie_file"
    RELEASE_COOKIE=$(arbiter_read_cookie "$arbiter_cookie_file") || RELEASE_COOKIE=""
  fi

  # Never fall through to the bundled releases/COOKIE. A throwaway cookie
  # leaves rpc unable to reach this node, which is the safe failure.
  if [ -z "$RELEASE_COOKIE" ]; then
    echo "warning: cannot read or create $arbiter_cookie_file; using a throwaway distribution cookie (bin/<%= @release.name %> rpc will not reach this node)" >&2
    RELEASE_COOKIE=$(arbiter_random_cookie)
  fi

  export RELEASE_COOKIE
  unset arbiter_data_home arbiter_cookie_file arbiter_cookie_value
fi
